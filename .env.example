# Copy to .env and fill in. Never commit .env.

# --- where it runs ---------------------------------------------------------
ENVIRONMENT=development            # production refuses to start without ACCESS_CODE, real hosts, HOST=127.0.0.1 and TRUST_PROXY=true
HOST=127.0.0.1
PORT=7860
ALLOWED_HOSTS=localhost,127.0.0.1  # production: your domain, e.g. 13-234-56-78.sslip.io
TRUST_PROXY=false                  # true only behind Caddy, with HOST=127.0.0.1

# Testers need this code to start calls. 8+ characters. Required in production.
ACCESS_CODE=

# --- LLM: Amazon Nova on Bedrock ------------------------------------------------
# AWS keys are NOT put here. Locally: `aws configure --profile vaani` stores
# them in ~/.aws/credentials and you set AWS_PROFILE=vaani. On EC2: leave
# AWS_PROFILE empty and attach an IAM role to the instance.
AWS_PROFILE=
AWS_REGION=ap-south-1
NOVA_MODEL_ID=global.amazon.nova-2-lite-v1:0

# --- speech: Sarvam (leave empty for text-only mode) -------------------------
SARVAM_API_KEY=
SARVAM_TTS_VOICE=roopa             # audition with: python -m scripts.try_voices
SARVAM_TTS_PACE=1.0                # 0.5-2.0
SARVAM_TTS_TEMPERATURE=0.7         # higher sounds more expressive
ASSISTANT_GENDER=                  # empty: follows the voice (female/male)

# --- WebRTC: optional TURN relay for callers behind strict firewalls ---------
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- limits (defaults shown) ---------------------------------------------------
MAX_CONCURRENT_VOICE_CALLS=3
CALLS_PER_IP_PER_HOUR=12
DAILY_CALL_BUDGET=150
CALL_MAX_SECONDS=600
LOG_LEVEL=INFO
